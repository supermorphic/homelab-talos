# Local privileged client credentials
/.talos/
/.kube/

# Talos generated configs and secrets
/clusterconfig/

# Defensive credential-name rules for files generated outside the canonical paths.
**/talosconfig
**/kubeconfig
**/controlplane.yaml
**/worker.yaml
**/controlplane-final.yaml
**/nuc*-controlplane.yaml

# Local decrypted material and generated output
/.secrets/
/.tmp/
/.cache/
/.mise/
/.mise.local.toml
/helm-output/
/support-bundles/
/.test-results/
/.test-reports/
/.test-campaigns/
*.dec.yaml
*.decrypted.yaml

# macOS
.DS_Store

# editor junk
.vscode/
.idea/

# Python (uv-managed; probe analyzer bytecode/caches)
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
