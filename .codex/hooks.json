        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/hooks/pre-tool-use.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
