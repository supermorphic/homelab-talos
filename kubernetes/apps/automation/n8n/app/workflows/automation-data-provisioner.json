      "parameters": {
        "jsCode": "const domain = $('Normalize Request').first().json.domain;\nconst pages = $input.all().map((item) => item.json);\nif (!pages.length || pages.some((page) => !page || !Array.isArray(page.data)) || pages[pages.length - 1].nextCursor) throw new Error('incomplete_credential_snapshot');\nconst credentials = pages.flatMap((page) => page.data);\nconst exact = (kind) => credentials.filter((item) => item.name === `automation-data/${domain}/${kind}`);\nconst migrators = exact('migrator');\nconst runtimes = exact('runtime');\nif (migrators.length !== 1 || runtimes.length !== 1) throw new Error('ready_credential_set_invalid');\nif (migrators[0].type !== 'postgres' || runtimes[0].type !== 'postgres') throw new Error('wrong_credential_type');\nreturn [{ json: { domain, migrator: migrators[0], runtime: runtimes[0] } }];"
