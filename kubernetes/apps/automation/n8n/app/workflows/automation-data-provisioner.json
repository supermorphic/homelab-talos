      "parameters": {
        "jsCode": "const domain = $('Normalize Request').first().json.domain;\nconst pages = $input.all().map((item) => item.json);\nif (!pages.length || pages.some((page) => !page || !Array.isArray(page.data)) || pages[pages.length - 1].nextCursor) throw new Error('incomplete_credential_snapshot');\nconst credentials = pages.flatMap((page) => page.data);\nconst select = (kind) => {\n  const name = `automation-data/${domain}/${kind}`;\n  const matches = credentials.filter((item) => item.name === name);\n  if (matches.length > 1) throw new Error('duplicate_domain_credential');\n  if (matches[0] && matches[0].type !== 'postgres') throw new Error('wrong_credential_type');\n  return matches[0] || null;\n};\nconst migrator = select('migrator');\nconst runtime = select('runtime');\nreturn [{ json: { domain, migrator, runtime, migratorExists: Boolean(migrator), runtimeExists: Boolean(runtime) } }];"
