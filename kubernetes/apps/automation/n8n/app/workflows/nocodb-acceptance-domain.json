    {
      "parameters": {
        "operation": "executeQuery",
        "query": "BEGIN;\nSET LOCAL ROLE issue334_acceptance_owner;\nCREATE SCHEMA IF NOT EXISTS read_model AUTHORIZATION issue334_acceptance_owner;\nCREATE SCHEMA IF NOT EXISTS operator AUTHORIZATION issue334_acceptance_owner;\nCREATE TABLE IF NOT EXISTS app.acceptance_fact (\n  id bigint PRIMARY KEY,\n  fact text NOT NULL\n);\nCREATE OR REPLACE VIEW read_model.acceptance_facts AS\nSELECT id, fact FROM app.acceptance_fact;\nCREATE TABLE IF NOT EXISTS operator.acceptance_decision (\n  id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,\n  run_id text NOT NULL,\n  decision text NOT NULL,\n  protected_created_at timestamptz NOT NULL DEFAULT clock_timestamp()\n);\nCOMMIT;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        0,
        -300
      ],
      "id": "20000000-0000-4000-8000-000000000005",
      "name": "Create Acceptance Structure",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const request = $('Normalize Acceptance Request').first().json;\nreturn [{ json: { ok: true, operation: request.operation, runId: request.runId, domain: 'issue334_acceptance', structureReady: true } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        -300
