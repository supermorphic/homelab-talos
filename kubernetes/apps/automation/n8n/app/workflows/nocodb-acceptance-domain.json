    {
      "parameters": {
        "jsCode": "const context = $('Resolve Acceptance Tables').first().json;\nconst rows = Array.isArray($json) ? $json : ($json.list || []);\nif (rows.some((row) => row.run_id !== context.runId || row.id === undefined)) throw new Error('cleanup_scope_invalid');\nreturn [{ json: { ...context, deleteRows: rows.map((row) => ({ id: row.id })), removedCount: rows.length } }];"
