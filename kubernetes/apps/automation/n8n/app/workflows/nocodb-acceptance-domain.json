    {
      "parameters": {
        "jsCode": "const context = $('Normalize Inserted Decision').first().json;\nconst rows = Array.isArray($json) ? $json : ($json.list || []);\nconst matches = rows.filter((row) => row && row.run_id === context.runId && (row.id ?? row.Id) === context.recordId);\nif (matches.length !== 1 || matches[0].decision !== 'pending') throw new Error('insert_probe_failed');\nreturn [{ json: { ...context, protectedCreatedAt: matches[0].protected_created_at } }];"
