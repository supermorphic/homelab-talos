    {
      "parameters": {
        "jsCode": "const request = $('Normalize Acceptance Request').first().json;\nconst bases = Array.isArray($json) ? $json : ($json.list || $json.data || []);\nconst matches = bases.filter((base) => base && base.title === 'issue334_acceptance');\nif (matches.length !== 1 || !matches[0].id) throw new Error(matches.length > 1 ? 'duplicate_acceptance_base' : 'acceptance_base_missing');\nreturn [{ json: { ...request, domain: 'issue334_acceptance', baseId: matches[0].id } }];"
