    {
      "parameters": {
        "jsCode": "const context = $('Keep Acceptance Sources').first().json;\nconst items = $input.all().map((item) => item.json);\nconst tables = Array.isArray($json) ? $json : ($json.list || $json.data || (items.every((item) => item && item.id) ? items : []));\nconst facts = tables.filter((table) => table && table.title === 'acceptance_facts' && table.source_id === context.readerSourceId);\nconst decisions = tables.filter((table) => table && table.title === 'acceptance_decision' && table.source_id === context.operatorSourceId);\nif (facts.length !== 1 || decisions.length !== 1 || !facts[0].id || !decisions[0].id) throw new Error('acceptance_reflection_invalid');\nreturn [{ json: {\n  ...context,\n  factsTableId: facts[0].id,\n  decisionTableId: decisions[0].id,\n  reflectedSchemas: ['read_model', 'operator'],\n  reflectedTables: tables.map((table) => ({ id: table.id, title: table.title, sourceId: table.source_id })),\n  cleanupOnly: context.operation === 'cleanup'\n} }];"
