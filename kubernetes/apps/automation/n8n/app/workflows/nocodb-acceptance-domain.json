      "parameters": {
        "jsCode": "const context = $('Resolve Acceptance Tables').first().json;\nconst record = Array.isArray($json) ? $json[0] : $json;\nconst recordId = record?.id ?? record?.Id;\nif (recordId === undefined || recordId === null) throw new Error('inserted_decision_id_missing');\nreturn [{ json: { ...context, recordId } }];"
