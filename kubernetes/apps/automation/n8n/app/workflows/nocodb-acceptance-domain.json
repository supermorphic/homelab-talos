    {
      "parameters": {
        "jsCode": "const context = $('Resolve Acceptance Base').first().json;\nconst items = $input.all().map((item) => item.json);\nconst sources = Array.isArray($json) ? $json : ($json.list || $json.data || (items.every((item) => item && item.id) ? items : []));\nconst reader = sources.filter((source) => source && source.alias === 'Read Model');\nconst operator = sources.filter((source) => source && source.alias === 'Operator');\nif (reader.length !== 1 || operator.length !== 1) throw new Error('acceptance_source_set_invalid');\nreturn [{ json: { ...context, sources, readerSourceId: reader[0].id, operatorSourceId: operator[0].id } }];"
      },
